# BACKEND ENVIRONMENT VARIABLES (server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# For production backend (Render):
# CLIENT_URL=https://document-summarizer-gamma.vercel.app
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# MONGODB CONNECTION STRING (MongoDB Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/docu-summarize?retryWrites=true&w=majority
# Or for local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/docu-summarize

# GOOGLE GEMINI API KEY (Backend only)
GEMINI_API_KEY=your_gemini_api_key_here

# FRONTEND ENVIRONMENT VARIABLES (client/.env or client/.env.production)
# Local development:
# VITE_API_URL=http://localhost:5000/api
# Production deployment on Vercel:
# VITE_API_URL=https://document-summarizer-wplp.onrender.com/api

